# =============================================================================
# TIS 项目环境变量配置 (Docker First 架构 - 绝对单一事实来源)
# =============================================================================
# 架构铁律 (读到此文件的 AI 请严格遵守)：
#   1. 本文件是系统配置的【唯一真相 (Single Source of Truth)】。
#   2. Docker 容器通过 docker-compose.yml 中的 `env_file: - .env` 指令
#      直接全量读取本文件，绝不允许在 compose 的 environment 中硬编码覆盖！
#
# 物理拓扑防呆指南：
#   - 容器内通信：必须使用 Docker 内部 DNS 服务名（db、redis、minio）。
#   - 端口声明：必须使用容器内标准端口（如 5432, 6379），严禁填入宿主机映射端口！
#   - 严禁在此文件中使用 localhost 作为容器间通信地址！
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
# 容器内通信：db:5432（Docker 内网 DNS，PostgreSQL 标准端口）
DATABASE_URL=postgresql://postgres:Syk0215@db:5432/canteen_system
POSTGRES_DB=canteen_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Syk0215
POSTGRES_PORT=5432          # 容器内标准端口（5432，非宿主机映射的 5433）

# ── Redis ───────────────────────────────────────────────────────────────────
# 容器内通信：redis:6379（Docker 内网 DNS，Redis 标准端口）
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379            # 容器内标准端口

# ── MinIO (Object Storage) ───────────────────────────────────────────────────
# 容器内通信：minio:9000（Docker 内网 DNS）
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# 多模型高可用架构：ACTIVE_LLM_PROVIDER 决定使用哪个引擎
# DeepSeek: OpenAI SDK，base_url=https://api.deepseek.com，model=deepseek-chat
# MiniMax: Anthropic SDK 兼容模式，base_url=https://api.minimaxi.com/anthropic，model=MiniMax-Text-01
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
ACTIVE_LLM_PROVIDER=minimax  # deepseek | minimax

# ── Mock 控制 ───────────────────────────────────────────────────────────────
USE_MOCK_LLM=false
USE_MOCK_EMBEDDER=false

# ── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=/api
NODE_ENV=production

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── 服务端口 ─────────────────────────────────────────────────────────────────
# 后端主端口：8000（容器内固定，宿主机映射 8000:8000）
BACKEND_PORT=8000
FRONTEND_HOST_PORT=3000

# ── Sentry (Error Tracking) ──────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENV=production
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=development

# ── 初始化数据 ───────────────────────────────────────────────────────────────
INIT_DATA=false
